{
  "servers": {
    "control": {
      "command": "{root}/venv/bin/python",
      "args": ["-I", "{root}/servers/control_server.py"],
      "relative_paths": "refused",
      "environment": {
        "MPLBACKEND": "Agg"
      },
      "directories": [],
      "links": {},
      "tools": {
        "frequency_response": {"system": "object", "omega": "object"},
        "margins": {"system": "object"},
        "poles_zeros": {"system": "object"},
        "step_response": {"system": "object", "times": "object", "output_unit": "string"}
      },
      "denied": []
    },
    "mujoco": {
      "command": "{root}/venv/bin/python",
      "args": ["-I", "{root}/servers/mujoco_server.py", "--root", "{worktree}"],
      "relative_paths": "worktree",
      "environment": {},
      "directories": [],
      "links": {},
      "tools": {
        "load_model": {"path": "read_path", "xml": "string"},
        "model_info": {},
        "reset": {},
        "state": {},
        "step": {"steps": "integer", "controls": "array"}
      },
      "denied": []
    }
  },
  "refused_tools": [
    "agent_flash_monitor_verify", "agent_generate_board_report", "agent_monitor_health",
    "agent_resolve_target", "capture_serial_window", "coredump", "debug_cmd", "debug_list",
    "debug_start", "debug_stop", "flash_verification", "get_board_info", "get_monitor_status",
    "list_boards", "list_devices", "list_targets", "memory_watch", "monitor_capture",
    "port_diagnose", "power_profile", "run_target", "run_tests", "serial_session_list",
    "serial_session_read", "serial_session_start", "serial_session_stop", "serial_session_write",
    "start_monitor", "stop_monitor", "upload_filesystem", "upload_firmware", "upload_ota"
  ]
}
