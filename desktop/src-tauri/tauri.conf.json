{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "physgate",
  "version": "0.1.0",
  "identifier": "local.physgate.desktop.trial",
  "build": {
    "frontendDist": "../status"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": [
        "onboarding"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "The physgate operator UI in its own window",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "dangerousInsecureTransportProtocol": true
    }
  }
}
