      "period"
     ],
     "of": "previous.p_prev"
    },
    {
     "sign": 1,
     "of": "tilt_rate"
    }
   ]
  },
  {
   "name": "command",
   "unit": "1",
   "terms": [
    {
     "sign": -1,
     "coefficients": [
      "k_phi"
     ],
     "of": "line.phi_hat"
    },
    {
     "sign": 1,
     "coefficients": [
      "k_phi"
     ],
     "of": "wheel_reference"
    },
    {
     "sign": -1,
     "coefficients": [
      "k_theta"
     ],
     "of": "line.theta_now"
    },
    {
     "sign": -1,
     "coefficients": [
      "k_w"
     ],
     "of": "line.w_hat"
    },
    {
     "sign": -1,
     "coefficients": [
      "k_rate"
     ],
     "of": "tilt_rate"
    },
    {
     "sign": -1,
