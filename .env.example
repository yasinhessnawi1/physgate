# Names only. Copy to .env (ignored) and fill in; nothing here is a value.
#
# The subscription's long-lived token, from `claude setup-token`. Read when a
# run's parameters say "auth": "subscription".
CLAUDE_CODE_OAUTH_TOKEN=
# An API key. Read when a run's parameters say "auth": "api_key".
ANTHROPIC_API_KEY=
# Optional: another endpoint for the model calls. Unset means the binary's
# default. A run records it (without any credential in it) and refuses to be
# resumed against another.
ANTHROPIC_BASE_URL=
