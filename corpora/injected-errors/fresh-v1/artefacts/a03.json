{
 "id": "a03",
 "error_class": "propagation",
 "expected_check": "propagation",
 "assigned_role": "mechanical",
 "description": "Changing the external gear pair to 47:19 takes the overall reduction from 148.3:1 to 127.3:1. The encoder counter, which converts motor-shaft counts to wheel revolutions, keeps the base overall_gear_ratio of 148.3 with no reason given, so firmware under-reports wheel rotation by 127.3/148.3 (about 14 %) and the speed controller acts on a wheel speed that is low by that factor. (gearbox_right constrains the counter too, so its edge is also unwritten.)",
 "edge": {
  "source": "mechanical.gearbox_left",
  "target": "firmware.encoder_counter"
 },
