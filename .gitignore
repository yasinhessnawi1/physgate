# Private working docs, same sensitivity tier as .env — except the architecture
# specification, which the experiments and the thesis cite by path and by ARCH-nnn.
.docs/*
!.docs/02-architecture-specification.md

.venv/
__pycache__/
*.pyc

# Tool caches. The lockfile is deliberately NOT ignored — it is what makes a
# fresh clone resolve to the same versions this tree was checked against.
.pytest_cache/
.mypy_cache/
.ruff_cache/

.DS_Store

# Local Claude Code instructions; stays on this machine.
CLAUDE.md
