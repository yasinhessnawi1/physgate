# Private working docs, same sensitivity tier as .env — except the architecture
# specification, which the experiments and the thesis cite by path and by ARCH-nnn.
.docs/*
!.docs/02-architecture-specification.md

# Secrets. .env.example lists the names and is tracked.
.env

.venv/
__pycache__/
*.pyc

# Tool caches. The lockfile is deliberately NOT ignored: it pins every runtime
# and development dependency a fresh clone installs. It does not cover the
# build backend, which is resolved at build time and is not in the lockfile at
# all — that one is pinned exactly in the project file instead, with the
# measurement written beside it.
.pytest_cache/
.mypy_cache/
.ruff_cache/

.DS_Store

# Local Claude Code instructions; stays on this machine.
CLAUDE.md

# The pinned Claude Code binary the hook tests run, installed from the committed
# lockfile beside it. The lockfile is tracked; what it installs is not.
tests/integration/hooks/claude-code/node_modules/
